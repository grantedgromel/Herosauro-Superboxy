[gd_resource type="StandardMaterial3D" load_steps=3 format=3]

[ext_resource type="Texture2D" path="res://assets/textures/detail_granite_normal.tres" id="1_normal"]
[ext_resource type="Texture2D" path="res://assets/textures/detail_granite_mask.tres" id="2_mask"]

; Deck surface and parapet walls of the Dom Luis bridge: dark granite roadway.
;
; This was authored as "structural steel" (metallic 0.4, pale blue-grey albedo).
; On the deck -- a large flat up-facing plane -- that sampled sky IBL as a cold
; sheen and read as fresh snow, while the vertical parapets crushed to near
; black under the raking sun. Granite is both truer to the real bridge and far
; better behaved: dielectric, dark, rough, so deck and parapet stay in the same
; exposure range from every angle.

[resource]
resource_name = "BridgeGranite"
albedo_color = Color(0.283, 0.279, 0.271, 1)
metallic = 0.0
metallic_specular = 0.35
roughness = 0.88
; Kept deliberately low: the granite detail normal is high-contrast noise, and
; at deck scale anything above ~0.4 reads as loose gravel rather than paving.
normal_enabled = true
normal_scale = 0.3
normal_texture = ExtResource("1_normal")
roughness_texture = ExtResource("2_mask")
ao_enabled = true
ao_light_affect = 0.3
ao_texture = ExtResource("2_mask")
ao_texture_channel = 1
uv1_scale = Vector3(0.34, 0.34, 0.34)
uv1_triplanar = true
texture_filter = 5
