[gd_resource type="StandardMaterial3D" load_steps=6 format=3]

[ext_resource type="Texture2D" path="res://assets/textures/detail_masonry_normal.tres" id="1_normal"]
[ext_resource type="Texture2D" path="res://assets/textures/detail_masonry_mask.tres" id="2_mask"]
[ext_resource type="Texture2D" path="res://assets/textures/detail_fine_normal.tres" id="3_fine_normal"]
[ext_resource type="Texture2D" path="res://assets/textures/detail_fine_albedo.tres" id="4_fine_albedo"]
[ext_resource type="Texture2D" path="res://assets/textures/detail_masonry_albedo.tres" id="5_surface_albedo"]

; The structural granite mass of the Dom Luis deck: the 100 x 1.96 x 14 box in
; bridge_arena.tscn.
;
; WHAT THIS ACTUALLY DRESSES, corrected. The header used to call this "the deck
; surface", and it is not. bridge_arena.gd lays the carriageway bays, the tram bed,
; the kerbs and the flagstones ON TOP of the box as separate geometry with their own
; materials, so all the box's top face ever shows is the 4 cm inside every paving
; seam. What this material really owns is the slab's OUTER FASCIA -- the 100 m x
; 1.96 m vertical band down each side -- and its soffit. In 01_deck_mid that fascia
; is the single largest surface in shot: the band at y 478-600, 16.9% of the frame.
;
; --- Round 1: the bug that made that band pure black -----------------------
;
; Round 1 measured 01_deck_mid at y 478-605, across all 1280 px, as constant
; RGB (0, 1, 2) with a standard deviation of exactly 0.0, unchanged under a
; 3.2-gamma lift, and read it as "a surface with no material that not even ambient
; reaches".
;
; It was not a lighting failure. It was this line:
;
;     detail_blend_mode = 2
;
; BaseMaterial3D.BlendMode is MIX = 0, ADD = 1, SUB = 2, MUL = 3. The comment beside
; it asserted that 2 was MUL. It is SUB. Godot's detail pass was therefore computing
; ALBEDO - detail_tex.rgb, and detail_fine_albedo runs 0.68-1.00 against this
; material's 0.32, so the subtraction went negative on every texel of the surface and
; clamped to zero. The (0, 1, 2) the harness read back is not this surface at all: it
; is the grade LUT's own stop at input 0, Color(0, 0.002, 0.008), which is exactly
; (0, 1, 2) once written to 8-bit sRGB. That is why the standard deviation was 0.0 and
; why the gamma lift did nothing -- there was no signal underneath to lift.
;
; Corrected to 3. _atmosphere_probe.gd asserts it against BaseMaterial3D.BLEND_MODE_MUL
; by name, because the whole reason this file exists is to carry the same LAYERS
; ToonFactory does by hand, and by hand is where an enum gets mis-copied.
;
; --- Round 4: it stopped being granite, and became masonry -----------------
;
; With the band rendering again, a critic measured what it renders AS, and the numbers
; were reproduced in this tree before anything was changed:
;
;   row autocorrelation of G/R across y 490-590   peak at lag 214 px, r = 0.849
;   the same on luminance                          peak at lag 214 px, r = 0.747
;   (R-G) sd 8.08 against L sd 10.74               a hue / value ratio of 0.75
;
; Six visible repeats across the frame, on the largest surface in it, and the thing
; that repeated was COLOUR rather than FORM. Both numbers had one cause, and it was
; not the ramp: this material wore the GRANITE set at a 2.94 m square tile, and that
; set is authored for metre-scale masonry seen from any angle. Its albedo field is a
; 3-octave simplex at frequency 0.011 -- metre-scale blotches -- and its normal is a
; SEPARATE field at 0.060, i.e. 19 cm speckle, which at the 14 m this fascia sits from
; the camera is a quarter of a pixel and contributes nothing at all. So the surface
; presented one square tile of soft coloured blotch, thirty-four times along a hundred
; metres, with no relief underneath it. "Weathering blotch with no normal under it" is
; exactly right, and no amount of hue on a blotch field ever becomes a joint.
;
; It now wears its own set -- detail_masonry_* , generated by the `masonry` recipe in
; generate_detail_maps.gd, used by this material and nothing else -- built from a
; cellular field whose cell BORDERS are the mortar joints and whose cell INTERIORS are
; the block faces, with a per-block constant albedo registered to the same cells. Read
; that recipe for the field, the jitter and the three orthogonal colour axes.
;
; The two numbers that live HERE rather than there are uv1_scale and normal_scale, and
; they are the two the critic named. Both are below.

[resource]
resource_name = "BridgeMasonry"
; Authored value (0.315, 0.312, 0.305) -- pale grey river granite, near-neutral --
; carrying BOTH texture layers' mean corrections, because albedo_color is what both of
; them multiply:
;   x (0.8759, 0.8800, 0.8753)   the fine layer's net mean, per channel
;   x (0.7959, 0.8042, 0.7963)   the masonry albedo map's mean, per channel
; 0.315 / (0.7959 x 0.8759) = 0.4518. Read this as the value the AVERAGE texel's
; multiplier is undoing, not as the surface's colour: the MEAN across the surface is
; the authored near-neutral (0.315, 0.312, 0.305), which is what _atmosphere_probe.gd
; asserts directly rather than by hex compare.
;
; The authored value moved 0.283 -> 0.315, +11%, and that is the whole of the change:
; it is the one large stone surface in the game that sits BELOW the factory's
; PORTO_STONE_FLOOR of 0.44, and deliberately, because a spandrel is not paving. It is
; a permanently damp, algae-streaked, soot-stained vertical face two metres above a
; tidal river, and it faces the 34-degree sun almost square on (N.L 0.757 against the
; deck's 0.559), so at the floor it would render BRIGHTER than the playable corridor
; in front of it -- which is the RUBRIC failure the floor exists to fix, arrived at
; from the other side. 0.315 keeps it under the deck and off the bottom of the frame.
albedo_color = Color(0.4518, 0.4409, 0.4376, 1)
; Per-block colour, one flat value per ashlar block, with the colour boundaries landing
; exactly on the joints the normal is grooving (GRADIENT_INTERPOLATE_CONSTANT on a
; RETURN_CELL_VALUE field at the mask's own frequency, jitter and seed).
albedo_texture = ExtResource("5_surface_albedo")
metallic = 0.0
; F0 4%: the dielectric response every real mineral surface has. It matters more now
; than it did -- the fascia is a VERTICAL face, and with the sun re-keyed to 34
; degrees the sky it catches is most of what stops the band reading as a flat panel.
metallic_specular = 0.5
roughness = 0.88
; 0.34 -> 0.90, and this is the second half of the tiling fix rather than a taste call.
;
; The old number came with a warning that anything above ~0.5 "reads as loose gravel
; rather than as cut stone", and that warning was correct ABOUT THE GRANITE NORMAL:
; that map is 19 cm igneous speckle, and speckle at deck scale is gravel. The masonry
; normal is not speckle. It is a 5 cm mortar joint every 50 cm, which is FORM, and the
; measured defect was that this surface had no form at all -- a 7% non-monotone
; vertical swing across a 115 px plane, i.e. no normal doing any work. A joint has to
; survive the fine layer stacking on top of it at a 0.55 blend weight and it has to be
; visible at 14 m, so it gets nearly the full strength.
normal_enabled = true
normal_scale = 0.9
normal_texture = ExtResource("1_normal")
roughness_texture = ExtResource("2_mask")
; 0.52 -> 0.62. A raked mortar joint is a real 3-5 cm recess with a lip over it, and the
; 34-degree sun rakes ALONG this face rather than into it, so the key draws almost none
; of that recess itself and the AO term is what has to. Still short of the cobble
; recipe's 0.60-at-the-material, because a bed joint is not a sett grout full of moss.
ao_enabled = true
ao_light_affect = 0.62
ao_texture = ExtResource("2_mask")
ao_texture_channel = 1
; ANISOTROPIC, and this is the number the 214 px repeat was hiding in.
;
; 1/0.125 = 8.0 m along x and z, 1/0.25 = 4.0 m up y. Triplanar builds a z-facing
; surface's UV out of (x * scale.x, y * scale.y), so a square 32-texel cell in the map
; lands on this fascia as a block 1.00 m long and 0.50 m high -- coursed ashlar at the
; size a real granite bridge spandrel is laid in, out of a noise field that has no idea
; which way is up.
;
; It also moves the horizontal repeat from 2.94 m to 8.0 m. The fascia images at 72.8
; px per metre in 01_deck_mid, so the period goes from 214 px -- six repeats, which is
; what the eye and the autocorrelation both found -- to about 580 px, of which the
; frame holds 2.2. Vertically the tile is 4.0 m against a 1.96 m band, so the fascia
; shows half a tile and has no vertical repeat to find.
uv1_scale = Vector3(0.125, 0.25, 0.125)
uv1_triplanar = true
; The close-range layer. 1/0.28 = 3.571 tiles per metre, i.e. ~1.1 mm per texel, which
; is what is still resolving in 04_cobble_macro at a metre and a half from the surface
; at a grazing angle -- the shot that exists specifically because flat texturing is
; impossible to hide there. detail_uv_layer 1 is UV2; detail_blend_mode 3 is MUL, so
; the map modulates the granite colour instead of subtracting itself from it.
detail_enabled = true
detail_uv_layer = 1
detail_blend_mode = 3
detail_albedo = ExtResource("4_fine_albedo")
detail_normal = ExtResource("3_fine_normal")
uv2_scale = Vector3(3.571, 3.571, 3.571)
uv2_triplanar = true
; A rim term on a horizontal plane seen from above does nothing but lift the far end of
; the deck toward the sky colour, which is the opposite of the RUBRIC's "the playable
; corridor is the brightest, highest-contrast thing in frame". Off here, unlike the
; factory's default, and this is the one place the two deliberately disagree.
rim_enabled = false
texture_filter = 5
