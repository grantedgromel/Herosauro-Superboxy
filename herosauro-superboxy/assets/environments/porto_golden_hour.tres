[sub_resource type="Sky" id="Sky_porto"]
sky_material = SubResource("SkyMat_porto")
process_mode = 1
radiance_size = 3

; --- Grade_curve / Grade_lut ---
; The film grade, as a 1D LUT. adjustment_brightness/contrast/saturation are all
; achromatic, so they cannot do the one thing a golden-hour photograph always
; does: split-tone. Godot samples a Texture2D correction PER CHANNEL
; (out.r = LUT(in.r).r, and so on), which makes a GradientTexture1D exactly a
; curves editor with independent R, G and B.
;
; Read the stops as (input -> R, G, B):
;   0.000  a lifted, blue-shifted toe. Film never resolves to 0, and this is the
;          insurance against the parapets crushing that the render pass caught.
;          Kept small on purpose — if Godot hands this pass sRGB-encoded values
;          rather than linear ones the lift lands higher up the curve, and a big
;          toe would then read as fog on the blacks.
;   0.070  shade: B leads R by 0.017, so anything the sun misses goes cool.
;   0.200  neutral pivot. The mid-tones are AgX's business, not this curve's.
;   0.500  R leads B by 0.048 and the whole stop sits 4% above identity: the
;   0.800  highlight warm-and-lift that reads as low sun on stone.
;   1.000  clipping is (1.0, 0.978, 0.936), not white. Golden hour never clips
;          neutral, and a warm clip is what stops the sun disk and the glint path
;          reading as blown-out video.
; Every channel is monotonic, so no tonal inversion is possible whatever the
; input encoding turns out to be.
[sub_resource type="Gradient" id="Grade_curve"]
offsets = PackedFloat32Array(0, 0.07, 0.2, 0.5, 0.8, 1)
colors = PackedColorArray(0.004, 0.0055, 0.011, 1, 0.066, 0.07, 0.083, 1, 0.2, 0.199, 0.198, 1, 0.52, 0.505, 0.472, 1, 0.822, 0.8, 0.752, 1, 1, 0.978, 0.936, 1)

[sub_resource type="GradientTexture1D" id="Grade_lut"]
gradient = SubResource("Grade_curve")

[resource]
background_mode = 2
sky = SubResource("Sky_porto")

; --- Ambient ---
; 0.95 -> 0.55. This was the single biggest cause of the hazy, low-contrast read:
; a constant term that bright is a second key light with no direction, and it was
; being paid three times over — sky ambient, SDFGI (which reads the sky itself),
; and SSIL. SDFGI and SSIL are directional and occluded, so they are the ones that
; should carry the indirect; this is now only the floor for whatever the cascades
; miss. LightingRig scales it back up by COMPAT_AMBIENT_SCALE on GL Compatibility,
; where neither of those effects exists, and again if use_sdfgi is switched off.
;
; The colour is the 8% slice that is NOT sky (sky_contribution 0.92). It used to be
; warm, i.e. a second helping of sunlight into surfaces the sun cannot reach. Cool
; now, so it reads as sky fill; the shadows want blue, not more orange.
ambient_light_source = 3
ambient_light_color = Color(0.588, 0.694, 0.902, 1)
ambient_light_sky_contribution = 0.92
ambient_light_energy = 0.55
reflected_light_source = 2

; --- Tonemap ---
; exposure 1.2 -> 1.05 (-0.19 EV) and AgX white 12.0 -> 10.5.
; The two pull in opposite directions and that is deliberate. Exposure down keeps
; the sunlit deck out of the shoulder — at an 11.5 degree sun a horizontal deck
; only sees sin(11.5) = 0.20 of normal incidence, so if the deck was clipping it
; was exposure and glow doing it, not the key. White point down pulls the start of
; the shoulder from 12.0 to 10.5 scene-referred, which is what stops the ochre,
; cream and rose facades all converging on the same hot cream: they now roll off
; while they still have chroma left. agx_contrast 1.35 -> 1.42 buys the contrast
; back inside the tonemapper's own S-curve, which is cheaper and better behaved
; than doing it afterwards with adjustment_contrast.
tonemap_mode = 4
tonemap_exposure = 1.05
tonemap_agx_white = 10.5
tonemap_agx_contrast = 1.42

; --- Screen-space reflections ---
; The Douro reflecting the arch and the lit city is THE Porto image, so this is
; tuned for one specific case: a near-mirror plane (the water shader runs
; ROUGHNESS 0.07) seen at a grazing angle from 17 m up, with rays that have to
; travel most of the screen. max_steps 96 -> 112 for that reach; depth_tolerance
; 0.3 -> 0.22 because 0.3 is wider than the lattice members are thick and smears
; them into a smudge; fade_in 0.15 -> 0.05 so the reflection starts at the
; waterline instead of leaving a gap under the piers; fade_out 2.0 -> 6.0 so the
; far half of the reflection survives instead of dissolving mid-river.
ssr_enabled = true
ssr_max_steps = 112
ssr_fade_in = 0.05
ssr_fade_out = 6.0
ssr_depth_tolerance = 0.22

; --- SSAO / SSIL ---
; radius 0.9 is tuned to the ~2-unit characters, not the 100-unit deck.
; power 1.4 -> 1.2: with the new geometry every window reveal and lattice node has
; a real crease, and a 1.4 exponent turns each of them into a hard dark ring under
; a raking sun. A flatter power keeps AO as a gradient.
; ssil_intensity 0.65 -> 0.55: SSIL is the good kind of fill (directional, screen
; occluded) but it is still fill, and the ambient cut above already moved work onto
; it. 4.0 radius spans deck-to-parapet, which is the bounce that matters.
ssao_enabled = true
ssao_radius = 0.9
ssao_intensity = 1.5
ssao_power = 1.2
ssao_detail = 0.4
ssao_light_affect = 0.15
ssil_enabled = true
ssil_radius = 4.0
ssil_intensity = 0.55

; --- SDFGI ---
; 5 cascades off the default 0.2 min cell = a 12.8-unit cascade 0 and ~205 units
; total, enough for the bridge and the far bank. read_sky_light stays true (this is
; an exterior) and is stated explicitly because it is exactly why ambient_light_energy
; could come down so far. energy 0.9 -> 0.85 and bounce_feedback 0.4 -> 0.3: feedback
; is light amplification, and amplification is what turns indirect into wash.
sdfgi_enabled = true
sdfgi_use_occlusion = true
sdfgi_read_sky_light = true
sdfgi_bounce_feedback = 0.3
sdfgi_cascades = 5
sdfgi_y_scale = 1
sdfgi_energy = 0.85
sdfgi_normal_bias = 1.4
sdfgi_probe_bias = 1.4

; --- Glow ---
; SCREEN blend at intensity 0.45 over a threshold of 1.05 was lifting a lot more
; than the sun: at exposure 1.2 plenty of ordinary sunlit stone crossed 1.05, and
; screen-blending it is a mid-tone lift across the frame — a strong suspect for
; the "deck blowing out to white" the render pass caught. threshold 1.05 -> 1.15
; and intensity 0.45 -> 0.38 restrict it to what should actually bloom: the sun
; disk, the water's glint path, the lamp globes and the lit windows.
; luminance_cap 10 -> 8 stops the sun disk (28.8 scene-referred) from smearing the
; whole upper frame through the widest blur levels.
glow_enabled = true
glow_levels/1 = 0.0
glow_levels/2 = 0.3
glow_levels/3 = 0.7
glow_levels/4 = 1.0
glow_levels/5 = 0.8
glow_levels/6 = 0.4
glow_levels/7 = 0.0
glow_normalized = true
glow_intensity = 0.38
glow_bloom = 0.02
glow_blend_mode = 1
glow_hdr_threshold = 1.15
glow_hdr_luminance_cap = 8.0

; --- Depth fog: the aerial perspective ---
; Depth mode is amount = pow(smoothstep(begin, end, dist), curve) * density, so
; `density` is literally the blend at and beyond `end`. The old (45, 280, 0.75, 0.5)
; put the mid-ground city at 6% and the far bank at 50%, which is why the bridge,
; the Ribeira and the hills all sat in one plane. The new (26, 340, 0.62, 0.72)
; measures out, at the distances this scene actually has geometry:
;
;     deck / hero      0-25 m    0%      crisp, no veil on anything playable
;     bridge ends      45 m      4%
;     arch, abutments  70 m      12%
;     Ribeira terraces 100 m     21%
;     Clerigos, Serra  130 m     31%
;     scan, near edge  168 m     43%
;     scan, far edge   340 m+    72%
;
; That is a gradient of haze, which is what reads as depth. A constant one is the
; milky-screen failure and is what an earlier pass shipped.
;
; aerial_perspective 0.88 -> 0.92: the veil is 92% the actual sky behind the
; geometry, so distance takes on the sky's colour instead of a flat grey. The
; remaining 8% is fog_light_color, retinted from warm grey to haze amber so the
; veil is gold rather than dishwater. sun_scatter 0.35 -> 0.42 adds the low sun's
; own colour to the fog along sightlines within ~40 degrees of it — looking down
; the gorge is within 30 — which is the glare that sells a low sun over water.
; sky_affect stays 0: at anything above that the fog fogs the sky itself.
fog_enabled = true
fog_mode = 1
fog_light_color = Color(0.878, 0.706, 0.549, 1)
fog_sun_scatter = 0.42
; 0.72 veiled the whole frame: at that density the depth fog blended so far
; toward the sky colour that the Douro rendered as pale sand and the far bank
; nearly vanished. Aerial perspective needs a GRADIENT of haze, not a constant
; one, so density comes down and the begin distance moves out past the deck.
fog_density = 0.34
fog_aerial_perspective = 0.75
fog_sky_affect = 0.0
fog_depth_curve = 0.78
fog_depth_begin = 55.0
fog_depth_end = 340.0

; --- Volumetric fog: the god rays ---
; This exists for one shot: an 11.5 degree sun raking through the arch lattice.
; The lever for that is NOT density — density is extinction, which is uniform in
; every direction and is exactly the milkiness to avoid. It is:
;   anisotropy 0.55 -> 0.75. The Henyey-Greenstein phase function at g = 0.75 is
;     ~3.4x isotropic at 30 degrees off the sun and ~0.14x at 120, i.e. a 24:1
;     ratio between looking into the sun and away from it. The fog blazes where
;     the shafts are and all but disappears everywhere else.
;   the sun's own light_volumetric_fog_energy, which LightingRig raises to 2.4 at
;     runtime (a fog-only multiplier; it cannot touch surface lighting).
; Density actually goes DOWN, 0.002 -> 0.0016, and the fog energy above pays for
; it: shaft brightness goes as (fog energy * density), so 2.4 * 0.0016 buys the
; same shafts as 1.8 * 0.0022 while costing 27% less extinction. Extinction is the
; part that veils the playable deck, and at 50 m — the far parapet from mid-deck —
; that is the difference between a 15% and a 13% composite haze on geometry the
; player is standing on.
; length 96 -> 80 shortens the froxel volume so the same 64 depth slices land finer
; over the 10-40 m where the lattice actually is, and so the constant floor past
; the volume's end (1 - exp(-0.128) = 12%) stays low enough for the depth fog above
; to remain the thing shaping the far field.
; detail_spread 2.0 -> 2.6 bunches froxels nearer the camera for the same reason.
; gi_inject 0.8 -> 0.5 and ambient_inject 0.6 -> 0.3: both are UNIFORM lifts inside
; the fog, i.e. milk with no directional payoff, and they were fighting the
; anisotropy. sky_affect stays 0 or it fogs the sky.
; RiverLife adds a FogVolume of low mist over the water on top of this.
volumetric_fog_enabled = true
volumetric_fog_density = 0.0016
volumetric_fog_albedo = Color(1, 0.953, 0.898, 1)
volumetric_fog_gi_inject = 0.5
volumetric_fog_anisotropy = 0.75
volumetric_fog_length = 80.0
volumetric_fog_detail_spread = 2.6
volumetric_fog_ambient_inject = 0.3
volumetric_fog_sky_affect = 0.0

; --- Grade ---
; contrast 1.06 -> 1.04 and saturation 1.12 -> 1.05, because tonemap_agx_contrast
; now does the contrast inside the tonemapper and the sky carries far more chroma
; than it did. 1.12 on top of AgX's own saturation restoration was pushing the
; terracotta roofs toward neon. The LUT above is where the deliberate look lives.
adjustment_enabled = true
adjustment_contrast = 1.04
adjustment_saturation = 1.05
adjustment_color_correction = SubResource("Grade_lut")
