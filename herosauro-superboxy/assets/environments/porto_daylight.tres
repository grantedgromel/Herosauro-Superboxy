process_mode = 1
radiance_size = 3

; --- Grade_curve / Grade_lut ---
; The film grade, as a 1D LUT. adjustment_brightness/contrast/saturation are all
; achromatic, so a Texture2D correction is the only way to shape the three channels
; independently. Godot samples it PER CHANNEL (out.r = LUT(in.r).r, and so on), which
; makes a GradientTexture1D exactly a curves editor with independent R, G and B.
;
; The previous curve deliberately split-toned — warm highlights, cool shadows —
; because golden hour never clips neutral. Midday does. The job of this curve is now
; tonal SHAPE rather than colour separation, plus one deliberate piece of colour: a
; blue toe, because a shadow under a clear sky IS blue and that is the true colour of
; a shadow rather than a look. Saturation is left to adjustment_saturation, which does
; it without dragging hue.
;
; The shape is measured, not guessed. A first render of the daylight rig came back
; with this luminance distribution over shots 02, 03 and 07:
;
;     p1 0.12   p5 0.21   p50 0.61   p95 0.81   p99 0.87   fraction above 0.95: 0.000
;
; Nothing was clipping — but nothing reached white either, and the median sat two
; thirds of the way up. That is not a bright frame, it is a WASHED one, and it is the
; exact histogram the RUBRIC describes as "muddy" and "uniform flat illumination".
; The fix is not exposure (that only slides the whole thing) but RANGE: an S-curve
; with a real toe and a real shoulder, cutting the bottom fifth down and pulling the
; top fifth up toward white.
;
; Read the stops as (input -> R, G, B), with slopes in the margin:
;   0.000  (0, 0.005, 0.018)  — the only stop with real channel separation in it, and
;          it is DEEPER than it was (0.002/0.008 -> 0.005/0.018). Round 1 measured the
;          deck's shadows going redder than its lit stone, which is backwards under a
;          sky at (66, 151, 211). Most of that fix is in the lighting rig; this is the
;          part of it that belongs in the grade, and it costs nothing anywhere else
;          because it is applied at input 0 and has decayed to nothing by 0.08.
;   0.080  0.026.  slope 0.33 — the toe. This is where the frame gets its blacks, and
;          it is steeper than before because the shadows themselves are deeper now:
;          the directionless fill terms (ambient, SSIL) were nearly halved.
;   0.250  0.170.  slope 0.85
;   0.450  0.478.  slope 1.54 — the expansion band, and it is aimed. The bridge deck
;          measures 0.35-0.45 on the input side across 01, 02 and 07, so this is the
;          stretch the playable corridor actually occupies and the steepest slope in
;          the curve is spent on it. Separating two stones on the deck is worth more
;          than separating two roofs at a hundred metres.
;   0.620  0.630.  slope 0.89 — and the compression band, aimed the same way. The
;          Ribeira facades measure 0.55-0.65 on the input side. The RUBRIC wants the
;          background to sit back; giving it under-unity slope is the grade's share of
;          that, worth about six levels on its own.
;   0.760  0.800.  slope 1.21 — and released again, deliberately and immediately. The
;          first version of this curve held the compression all the way to 0.80, and a
;          render showed what that costs: the SKY's blue channel sits at input 0.75, so
;          it was being compressed along with the facades and came back at 190 against
;          the 211 Round 1 named as the one thing in the frame that was working. The
;          facades and the sky are separable — 0.55-0.65 against 0.75 — so the curve
;          separates them, compressing one band and lifting the next.
;   0.900  0.950.  slope 1.07.
;   1.000  (1, 1, 1). slope 0.50. Clean neutral white. A midday sun clips white; the
;          warm clip the old curve carried was the single most golden-hour thing left
;          in the frame after the light itself.
;
; Measured after the previous version shipped, over shots 02, 03 and 07: p1 0.11 ->
; 0.03, p5 0.23 -> 0.10, p50 0.65 -> 0.53, and 2.8% of the frame below 0.06 against
; 0.4% before. That is the toe working, and it is kept.
;
; The shoulder is a more honest story. The 99th percentile moved 0.87 -> 0.82, i.e.
; DOWN, and no amount of curve puts it at white — because in a shot with no cloud, no
; sun and no water glint in frame there is nothing in the arena brighter than a sunlit
; white kerb, and a sunlit white kerb is not white. Shot 07, which has cloud in it,
; reaches 0.90 at p99 and that is the correct answer for both. Forcing the rest of the
; way would mean +0.7 EV, which puts the median straight back where it started. The
; curve is left honest and the frame simply does not contain a white object.
;
; Every channel is monotonic, so no tonal inversion is possible whatever the input
; encoding turns out to be.
[sub_resource type="Gradient" id="Grade_curve"]
offsets = PackedFloat32Array(0, 0.08, 0.25, 0.45, 0.62, 0.76, 0.9, 1)
colors = PackedColorArray(0, 0.005, 0.018, 1, 0.026, 0.031, 0.043, 1, 0.17, 0.173, 0.182, 1, 0.478, 0.478, 0.478, 1, 0.63, 0.63, 0.629, 1, 0.8, 0.8, 0.799, 1, 0.95, 0.95, 0.95, 1, 1, 1, 1, 1)

[sub_resource type="GradientTexture1D" id="Grade_lut"]
gradient = SubResource("Grade_curve")

[resource]
background_mode = 2
sky = SubResource("Sky_porto")

; --- Ambient ---
; 0.55 -> 0.45 -> 0.32 -> 0.20. Ambient is the term with NO DIRECTION, which is the
; only thing that has ever mattered about it: it cannot shape a surface, it can only
; raise it, and every unit of it lands identically on a face pointing at the sky and a
; face pointing at the deck. Every unit that SDFGI, SSIL or a directional fill carries
; instead is a unit that arrives occluded and from somewhere.
;
; This round's cut, 0.32 -> 0.20, is Round 1's second measurement made actionable. It
; found the deck cobble's normal-map relief present outside a shadow band (standard
; deviation 8.5) and GONE inside it (2.4). Inside a shadow the only terms left are the
; fills, this, and the screen-space indirect — and this one and the indirect are both
; directionless, so between them they were most of the shadow's value and a normal map
; has nothing to bite on. The 0.12 taken out here goes back as directional sky fill in
; lighting_rig.gd (sky_fill_energy 0.32 -> 0.42 at a paler chroma), which is the same
; quantity of light arriving from the direction it actually arrives from.
;
; LightingRig scales it back up by COMPAT_AMBIENT_SCALE on GL Compatibility, where
; neither SDFGI nor SSIL exists, and again if use_sdfgi is switched off.
;
; The colour is the 8% slice that is NOT sky (sky_contribution 0.92). Still blue, and a
; touch paler: at midday that slice stands in for light bouncing off pale stone under a
; blue dome, not for a dusk gradient.
ambient_light_source = 3
ambient_light_color = Color(0.647, 0.749, 0.925, 1)
ambient_light_sky_contribution = 0.92
ambient_light_energy = 0.2
reflected_light_source = 2

; --- Tonemap ---
; This is where the daylight is actually made, not in any albedo. Which is why, when
; the albedos moved and this did not, the owner looked at the build and said
; "everything is just so bright to the point of being white".
;
; ROUND 5. exposure 0.72 -> 0.51, and NOTHING ELSE IN THIS FILE MOVED. Read the
; measurement before touching either number again, because two of the three claims the
; previous version of this block made are false and one of them cost a round.
;
; --- THE TRANSFER, MEASURED ------------------------------------------------
;
; Everything below was measured rather than modelled: a full-frame unshaded quad at a
; known scene-referred linear value, rendered through this exact resource, read back
; per channel. Godot's own AgX is a black box from here and reasoning about its
; internals is what went wrong. `u` is the tonemapper's input, i.e. scene-referred
; linear x tonemap_exposure, so exposure slides the whole table and nothing else does.
;
;     u     0.046  0.092  0.130  0.180  0.250  0.330  0.420  0.520  0.650  0.800  1.00
;   8-bit      26     60     92    125    145    161    178    192    205    215    225
;   slope         64     70     42     40     49     45     40     33     31   levels/stop
;
; Two things fall straight out of that table.
;
; FIRST, u = 0.18 lands on 125/255. The tonemapper's own middle grey is where middle
; grey belongs, so the CURVE is not the problem and never was. What the curve does have
; is a knee: it carries 64-70 levels per stop below u = 0.18 and only 33-45 above
; u = 0.5. Anything pushed past about u = 0.55 starts paying for its brightness in its
; own texture and its own chroma, because both are differences and the curve has
; stopped spending levels on differences up there.
;
; SECOND, and this is the one that cost a round: tonemap_agx_white IS NOT A RANGE
; CONTROL. Measured at u = 0.5, over a forty-to-one sweep of the white point:
;
;     white     1.0    2.0    4.0   16.0   40.0
;     8-bit     192    192    190    188    188
;
; Four levels. The previous version of this block reasoned from AgX's published log
; encoding that "dropping white to 4.0 narrows the encoded range to 14.5 stops, which
; lifts everything", and paired it with exposure 1.00 -> 0.72 to compensate for a lift
; that does not happen. The compensation was therefore a naked -0.47 EV, and it was
; applied to a frame that was already correctly placed. 4.0 is left where it is only
; because it demonstrably does nothing; do not spend another round here.
;
; --- WHY 0.51, AND WHY IT IS DERIVED RATHER THAN DIALLED --------------------
;
; The RUBRIC's rule is "exposure-driven, not multiplier-driven", and the corollary
; nobody wrote down is that an exposure has to be re-solved when the multipliers move.
; They moved. ToonFactory now applies a PORTO_STONE_FLOOR of 0.44 to every grey stone
; on the bridge — carriageway 0.325 -> 0.490, tram bed 0.235 -> 0.476 — and the deck
; fascia's albedo_color has climbed 0.283 -> 0.452 across six rounds. Every one of
; those was defensible and none of them is being unpicked here. What was missing is
; that the exposure this grade is anchored on was solved against the old numbers and
; nobody re-solved it.
;
; So it is solved, once, from the rig's own constants instead of by eye. A Lambertian
; 18% grey card lying on the deck receives, from lighting_rig.gd and from the block
; above this one:
;
;     key         SunLight 2.8 x sin(34) x luma(1, 0.935, 0.855)      1.477
;     SkyFill     0.42 x 0.866 x luma(0.72, 0.82, 1.00)               0.295
;     QuayBounce  arrives from BELOW, N.L = 0 on an up-facing surface  0
;     Ribeira     exactly level by construction, N.L = 0               0
;     ambient     ambient_light_energy, as an upper bound              0.200
;                                                              E_h  =  1.962
;
; and correct exposure is the one that puts that card on the tonemapper's middle grey:
;
;     tonemap_exposure = 0.18 / (0.18 x E_h) = 1 / E_h = 0.510
;
; SDFGI and SSIL are deliberately NOT in E_h. They are occluded terms that vary across
; the deck, so exposing for them means exposing for whichever patch of paving happens
; to be gathering the most bounce. _atmosphere_probe.gd gates this identity, and gates
; separately that the corridor's own delivered stone stays under the knee at u = 0.55.
;
; --- WHAT THAT DOES TO THE FRAME, MEASURED ---------------------------------
;
; Same regions, same cameras, all three rounds. Luminance out of 255, and saturation
; in brackets where it is the point:
;
;                                     r3        before       after
;     01 deck fascia, 16.9% of frame  104 (.29)  183 (.14)   160 (.16)   <- was white
;     02 playable deck                105 (.18)  155 (.12)   132 (.14)
;     02 far river / fog band         176        176         154        never moved
;     01 Ribeira facades              155        157         132
;     01 sky zenith, luminance        141        141         115
;     01 sky zenith, B channel        201        201         178
;     02 parapet shadow                52         58          41
;
; Read the third row first: the fog band is IDENTICAL across r3 and before, to within a
; tenth of a level, and so is every sky row. Nothing atmospheric moved. What moved was
; the ground, 105 -> 155 and 104 -> 183, until the two largest masses in the frame sat
; inside one narrow band at the top of the curve — and the deck's saturation halved on
; the way up, because at u = 0.67 the transfer has stopped spending levels on
; differences and colour is a difference. A large, bright, colourless surface next to
; another one is what "the bridge and the sky read as one white mass" describes.
;
; TWO THINGS THIS DELIBERATELY DOES NOT DO, both of which are the same fact:
;
; The fascia does not go back to r3's 104, and must not. The corridor's albedo gain is
; RELATIVE and exposure is a global scale, so a global scale cannot undo it — the
; deck-to-facade ratio runs 0.67 at r3, 1.17 before, 1.20 after. The corridor stays the
; brightest thing in frame, which is what the RUBRIC asks for and what the albedo work
; bought; all that comes off is the absolute lift that rode in with it.
;
; And for the same reason the fog band still sits above the deck — 154 against 132,
; essentially the ratio it already had (1.13 before, 1.16 after). That is NOT fixed
; here and cannot be, and the instrument for it is the sky shader's horizon hem rather
; than anything in this block. See the note above horizon_color in porto_sky.gdshader.
;
; The sky gets BLUER rather than duller, which is the knee running in reverse: the
; zenith's three channels sit at u 0.122 / 0.286 / 0.600, so the two dark ones drop
; onto the steep part of the curve while the bright one stays on the shallow part and
; the gap between them widens. Measured zenith saturation, 0.572 -> 0.746 in
; 01_deck_mid and 0.767 -> 0.869 in 02_deck_eye, i.e. up 13-30% while its luminance
; came DOWN. That is the answer to the obvious objection, which is that dropping the
; exposure must cost the one thing Round 1 said was working. The playable deck recovers
; the same way for the same reason: its own saturation goes 0.119 -> 0.140, and its
; local contrast — the thing a normal map and a detail layer exist to produce — comes
; back 21%, CoV 0.117 -> 0.142 on the near deck and 0.097 -> 0.117 on the fascia. Not
; one texture, material or map changed to buy that. It is entirely the surface being
; moved back onto a part of the curve that still has levels to spend on differences.
;
; A NOTE ON HOW THE NUMBER WAS CHOSEN, because it is reusable and it is cheap. The
; whole "after" column was PREDICTED before anything was rendered, by inverting the
; measured transfer on the before-capture pixel by pixel — new = T(k * T-inverse(old))
; with k the exposure ratio — and only then confirmed. Rendered against predicted, on
; 01_deck_mid: mean 116.3 / 117.0, median 129 / 130, p99 190 / 191, fraction over 200
; 0.43% / 0.43%, fascia 160.3 / 160.4. A capture on this hardware costs ten to fifteen
; minutes; the prediction costs two seconds, and it is exact for any change that is
; purely a change of transfer. It is not valid for anything scene-side — a fill energy,
; sky_energy, an albedo — because those move the input rather than the curve.
;
; --- WHAT THIS DOES NOT FIX ------------------------------------------------
;
; The 99th percentile lands at 190 and 180, i.e. the frame still contains nothing white.
; That is the honest answer and the previous round already wrote it down before talking
; itself out of it: with no cloud, no sun disk and no glint in frame, the brightest
; object in the arena is a sunlit kerb, and a sunlit kerb is not white. Buying a white
; point by over-exposing the mid-tones is precisely the trade that produced this
; regression. If the frame needs a white it needs a white OBJECT.
;
; agx_contrast 1.62, kept: it works inside the tonemapper's own S-curve, before the
; display transform rather than on top of it, which is better behaved than
; adjustment_contrast.
tonemap_mode = 4
tonemap_exposure = 0.51
tonemap_agx_white = 4.0
tonemap_agx_contrast = 1.62

; --- Screen-space reflections ---
; The Douro reflecting the arch and the lit city is THE Porto image, so this is tuned
; for one specific case: a near-mirror plane (the water shader runs ROUGHNESS 0.06)
; seen at a grazing angle from 17 m up, with rays that have to travel most of the
; screen. max_steps 112 for that reach; depth_tolerance 0.22 because 0.3 is wider than
; the lattice members are thick and smears them into a smudge.
;
; ROUND 4. fade_out 6.0 -> 1.5, and the old value was a units error of exactly the
; kind Round 2's detail_blend_mode was.
;
; NEITHER fade_in NOR fade_out IS A DISTANCE. Both are exponents on the ray march's
; own progress: Godot computes the blend of a hit found at fraction g along the march
; as pow(g, ssr_fade_in) * pow(1 - g, ssr_fade_out). The comment here used to read
; "fade_out 6.0 so the far half of the reflection survives instead of dissolving
; mid-river", which is the opposite of what 6.0 does — a hit at the halfway point kept
; 0.5^6 = 0.016 of itself, and a hit three quarters along kept 0.00024. It did not
; dissolve the far half of the reflection, it deleted everything except the first
; sixth.
;
; That is the wrong end to delete for water specifically. A reflection off a
; horizontal plane seen at a grazing angle has a reflected ray that is ALSO nearly
; horizontal, so it crawls across the screen and finds whatever it finds late in the
; march by construction. Two critics measured the consequence independently: a
; three-band sample of the Douro in shot 07 varied under 8% between water under bright
; terraces, open mid-span and water under a dark cliff, and a large iron arch stood
; over calm water in shot 06 and returned nothing. What DID survive was the reflection
; of things within a few metres of the surface — the near bank's own facades in shot
; 09 — which is exactly the signature of a fade that kills long rays.
;
; 1.5 keeps a midpoint hit at 0.354 and still rolls a hit in the last tenth of the
; march off to 0.03, which is the part that genuinely wants suppressing: at the end of
; the march the ray is off-screen or behind something and the sample is a smear.
; _atmosphere_probe.gd asserts the midpoint survival rather than the number.
;
; fade_in 0.05 is kept and was always right: pow(g, 0.05) is within 20% of 1.0 by the
; first step, so the reflection starts at the waterline instead of leaving a gap under
; the piers.
ssr_enabled = true
ssr_max_steps = 112
ssr_fade_in = 0.05
ssr_fade_out = 1.5
ssr_depth_tolerance = 0.22

; --- SSAO / SSIL ---
; radius 0.9 is tuned to the ~2-unit characters, not the 100-unit deck.
; power stays 1.2: every window reveal and lattice node has a real crease, and a
; sharper exponent turns each of them into a hard dark ring.
;
; light_affect 0.22 -> 0.15, back most of the way to where it started. It went up when
; the sun did, on the argument that a 51-degree key reaches into creases a raking one
; left in its own shadow, so the crease darkening had to be carried by AO instead. A
; 34-degree key rakes again and draws them itself. AO acting on DIRECT light was never
; physical either, and — like ambient — it has no direction, so it is one of the terms
; flattening relief inside a shadow.
; intensity 1.85 -> 1.60 for the same reason, plus this: the extra was paying for an
; ambient cut, and ambient has now been cut again with a DIRECTIONAL fill absorbing it.
; Occluding a term that already arrives from a direction is double-counting.
;
; ssil_intensity 0.60 -> 0.32 and ssil_radius 4.0 -> 2.4, and this is the third of the
; three changes Round 1's shadow-chroma finding forced. SSIL gathers screen-space
; indirect, i.e. light that has been through a bounce off whatever is nearby — and what
; is nearby on the bridge deck is sunlit warm granite and warm cobble, so it comes back
; WARMER than the sun itself. That is why the measured shadow went redder than the lit
; stone even though both directional fills reaching an up-facing surface are decisively
; blue: the cool light had direction and small energy, the warm light had no direction
; and large energy, and the warm one won.
; The radius matters as much as the intensity. At 4.0 units a point on flat paving
; gathers from four metres of the same flat paving, which no real surface can see — a
; plane has no view factor to itself. 2.4 keeps SSIL doing what it is good at (kerbs,
; parapet plinths, the inside of the truss, anywhere geometry really does face other
; geometry) and stops it inventing a warm floor across open deck.
ssao_enabled = true
ssao_radius = 0.9
ssao_intensity = 1.6
ssao_power = 1.2
ssao_detail = 0.4
; 0.15 -> 0.50 in Round 3, and HELD at 0.50 in Round 4 after the question was
; finally measured instead of argued. Do not raise it again; the reason follows,
; because three rounds have now spent effort here on a premise that is false.
;
; ssao_light_affect decides how much of the occlusion term is allowed to touch
; DIRECT light; the remainder lands only on the indirect terms. Round 3 raised it
; to 0.50 for contact darkening under the lamp standards and the deck bollard, and
; the capture that followed still showed no dip in the paving under any of them.
;
; MEASURED, in an isolated render rather than in the arena where texture noise
; hides everything: a plane, three posts of 0.12 / 0.30 / 0.80 m diameter, a wall
; corner, this exact key, ambient and grade, rendered with SSAO on and off and
; differenced.
;
;   ambient-only control (key off)    post 0.12 m  -2.55 L (3.0%)   corner -7.90 L
;   this rig, as shipped              post 0.12 m  -0.19 L (0.2%)   corner -1.96 L
;   5x intensity, light_affect 1.0    post 0.12 m  -0.78 L (0.7%)   corner -8.82 L (17%)
;
; SSAO IS generating occlusion at radius 0.9, and its SHAPE is right — amplify the
; difference and there is a clean contact halo at every post base, thin one
; included. Its MAGNITUDE under this rig is 0.2% of the pixel, on paving whose own
; texture deviation is 10-15 L. It is a sixth of one standard deviation of the
; noise it is drawn on. That is why raising light_affect changed nothing
; measurable, and the third row is why raising it further cannot help: at the
; setting that finally plants a lamp post, every inside corner in the frame has
; become a dirt ring.
;
; The cause is structural, not a value. AO occludes INDIRECT light plus whatever
; fraction of DIRECT light this number concedes — and this rig has spent three
; rounds deliberately deleting the indirect (ambient 0.55 -> 0.20, ssil 0.60 ->
; 0.32, sdfgi 0.95 -> 0.80) because directionless light is what killed normal-map
; relief inside shadows. Those cuts were right and are not being reversed. The
; consequence is that AO has almost nothing left to take away: the same AO is 13x
; stronger in the ambient-only control purely because there is light there for it
; to occlude.
;
; The obvious alternative was tried in the same harness and is worse: giving
; LightingRig's SkyFill a shadow map with a 30-degree angular diameter puts a
; second CAST SHADOW streaking away from every object in a direction the sun is
; not, plus shadow acne across open paving. Two suns beats no contact patch only
; if you are not looking at the frame.
;
; So contact under a sunlit object is not this stream's to give. It has to come
; from geometry or a decal — the world stream's moulded feet and contact patches,
; which moved one lamp's ground transition from 4/39/128/174 to 4/21/66/180, are
; the right instrument and want more of the same. _atmosphere_probe.gd now gates
; the only thing that is genuinely this file's: that enough occludable indirect
; light survives for AO to darken a crease at all.
ssao_light_affect = 0.5
ssil_enabled = true
ssil_radius = 2.4
ssil_intensity = 0.32

; --- SDFGI ---
; 5 cascades off the default 0.2 min cell = a 12.8-unit cascade 0 and ~205 units total,
; enough for the bridge and the far bank. read_sky_light stays true (this is an
; exterior) and is stated explicitly because it is exactly why ambient_light_energy
; could come down so far. energy 0.95 -> 0.80 and bounce_feedback 0.3 -> 0.2: SDFGI is
; still the only thing in the frame that carries bounce with the colour of what it
; bounced off *and* with occlusion, which the RUBRIC asks for by name — green off the
; banks, terracotta off the roofs — so it is trimmed rather than cut. But it sits on the
; warm side of the same argument as SSIL above: what the deck is surrounded by is
; sunlit warm stone, feedback is light amplification, and amplifying a warm bounce is
; precisely how a shadow ends up redder than the surface casting it.
sdfgi_enabled = true
sdfgi_use_occlusion = true
sdfgi_read_sky_light = true
sdfgi_bounce_feedback = 0.2
sdfgi_cascades = 5
sdfgi_y_scale = 1
sdfgi_energy = 0.8
sdfgi_normal_bias = 1.4
sdfgi_probe_bias = 1.4

; --- Glow ---
; threshold 1.15 -> 1.00, chosen against the post-exposure list in the tonemap block
; rather than by feel. The brightest ordinary lit surface in the arena is a sunlit
; white kerb at 0.88; the brightest thing that is not a surface is the sun disk at 32,
; with the water's specular and the azulejo glaze between them. 1.00 is the only value
; that separates those two populations cleanly, and separating them is the whole job:
; below it, glow starts screen-blending ordinary sunlit stone, which is a mid-tone lift
; across the frame and the fastest way to turn a bright day into a hazy one.
;
; This pass first tried 1.25 on the reasoning that "everything got brighter". That was
; true of the render it was written against and stopped being true when exposure came
; down four paragraphs above — at 1.25 nothing in the arena except the sun disk could
; reach the glow pass at all, which is a bloom that never fires.
; intensity 0.38 -> 0.34: with the threshold doing the selecting properly, the strength
; only has to carry the sun and the glints.
;
; ROUND 5, and UNCHANGED because it was ruled out rather than left alone. The white
; frame the owner reported had an obvious glow explanation — glow_blend_mode is SCREEN,
; and a threshold that had drifted under ordinary sunlit stone would screen-blend the
; whole frame toward white, which is the exact failure the paragraph above warns about.
; Measured instead of assumed, with the same full-frame flat field the tonemap block's
; table came from, rendered with glow_enabled true and false and differenced:
;
;     scene-referred   0.02  0.10  0.38  0.60  1.20  2.00  3.50
;     glow contributes    0     1     0     1     0     0     1   levels out of 255
;
; Glow is not touching any surface in this arena. It is doing its job on the sun disk
; and the glints and nothing else, which is what the threshold was tuned for.
; luminance_cap 8 stops the sun disk from smearing the upper frame through the widest
; blur levels.
glow_enabled = true
glow_levels/1 = 0.0
glow_levels/2 = 0.3
glow_levels/3 = 0.7
glow_levels/4 = 1.0
glow_levels/5 = 0.8
glow_levels/6 = 0.4
glow_levels/7 = 0.0
glow_normalized = true
glow_intensity = 0.34
glow_bloom = 0.02
glow_blend_mode = 1
glow_hdr_threshold = 1.0
glow_hdr_luminance_cap = 8.0

; --- Depth fog: the aerial perspective ---
; Depth mode is amount = pow(smoothstep(begin, end, dist), curve) * density, so
; `density` is literally the blend at and beyond `end`. Density is not the milkiness
; dial — RANGE is. Full density over a 640 m range gives a gradient rather than a veil,
; and a gradient is what reads as depth.
;
; --- What Round 1 forced here, and what it forbade -------------------------
;
; Two measurements, and they point the same way. The playable bridge deck came back at
; roughly HALF the luminance and 40% of the saturation of the furthest thing in shot
; (02_deck_eye: deck L=81 sat=0.14 against facades L=161 sat=0.35; 07_ribeira: deck
; L=74 sat=0.16 against deep background L=146 sat=0.27). The RUBRIC requires the exact
; opposite. And separately, the critics observed that what depth this scene HAS is
; carried almost entirely by distance blur — which softens the arch, the one object in
; the frame that identifies the location, while leaving the disposable background
; sharp and shouting.
;
; So more blur is explicitly the wrong move and none was added. Depth belongs in value
; compression and desaturation toward the sky, which is what this block is: with
; aerial_perspective at 0.90, nine tenths of the veil is the actual sky BEHIND the
; geometry, so distance literally takes the sky's own colour. That pulls a saturated
; ochre facade toward a pale blue without touching the palette itself, and the Ribeira
; chord — cobalt, vermilion, ochre, cream — is the right chord for Porto and is not
; what is wrong.
;
; begin 40 -> 18 and curve 0.90 -> 0.62 in Round 3, which roughly doubled the veil
; right across the mid-ground while leaving the playable corridor alone.
;
; ROUND 4: fog_depth_end 640 -> 520, and it is the RANGE that moves rather than the
; density or the curve, deliberately. Round 3's critics measured the same-material
; saturation series up the left bank of shot 07 running near-to-far 0.265 -> 0.301 ->
; 0.323 — saturation RISING with distance, which is an inverted atmospheric model —
; and separately measured background saturation (0.32) sitting at two and a half
; times the playable deck's (0.13). The correct instrument for that is more veil in
; the 80-200 m band where the Ribeira terraces stand, because a veil is what strips
; chroma: mixing a terracotta facade 24% toward the pale hem takes its saturation
; from 0.55 to 0.40, and 42% takes it to 0.28. Density cannot deliver that (it is
; already 1.0 and it only scales the far end) and curve cannot (it lifts the near
; field at the same rate, and the playable corridor has a 9% ceiling in the probe).
;
; Composited with the volumetric pass below, at the distances this scene has geometry:
;
;                            r2      r3      r4
;     deck / hero      0-40 m  <4%     6.1%    7.0%   nothing playable is veiled
;     bridge ends      50 m     6%     8.6%   10.0%
;     arch, abutments  70 m     9%    13.6%   15.9%
;     Ribeira terraces 100 m   12%    20.4%   24.4%   where the over-bright facades are
;     Clerigos, Serra  130 m   16%    26.6%   32.3%
;     scan, near edge  168 m   22%    34.7%   42.3%
;     scan, far edge   340 m   57%    69.2%   81.8%
;     horizon          520 m+ 100%    100%   100%    the water reaches sky colour before
;                                                    its geometry runs out, so the river
;                                                    plane's far edge is never a seam
;
; The ramp is monotone at every sample, which is the whole depth cue — a dip anywhere
; means near geometry hazier than something behind it. _atmosphere_probe.gd checks it,
; and LightingRig's three COMPAT_FOG_* constants were re-solved against this curve in
; the same edit (worst mismatch 0.0065 over 10-410 m, against a 0.06 gate).
;
; What this does NOT fix, and should not be asked to: the veil BRIGHTENS as well as
; desaturates, because with aerial_perspective at 0.90 it converges on the sky and the
; horizon hem of a clear sky is genuinely bright. A critic measured the far river in
; shot 02 at L 176-184 against a mean deck of 110 and called the eye to it, correctly.
; That gap closes from the other end — by the playable corridor getting brighter, which
; is the materials stream's albedo work — and NOT by dimming the sky, which would make
; a clear Porto morning read as overcast. Adding veil without that is the milky-screen
; failure this project already shipped once, so the two halves have to land together.
;
; ROUND 5 FOLLOWED UP ON THAT PREDICTION, and it is worth recording that it came true
; and then went past true. The corridor did get brighter — 110 -> 167 — and the gap did
; close, and then the deck kept going until it sat level with the fog band at 176 with
; nothing between them, which is what the owner saw as one white mass. The half of the
; trade this block asked for arrived; the other half, re-solving the exposure the new
; albedos are seen through, did not, and that is fixed in the tonemap block above. The
; fog band itself is UNCHANGED by that fix's own arithmetic — it comes down with
; everything else, from 176 to 156 against a deck at 147-167 — so nothing here needed
; moving and nothing here was moved. The instruction not to dim the sky still stands.
;
; Two more numbers here changed earlier, when the sunset went:
;
; fog_light_color, warm haze amber -> pale sky blue -> (0.706, 0.769, 0.824). This is
; the 10% of the veil that is NOT the sky behind the geometry — the airlight's own
; colour rather than the dome's — and it comes down in both value and chroma this
; round for the same reason the range came in: it is the one part of the veil that can
; desaturate without also brightening. B-R stays +0.118, so it is still decisively a
; daylight haze rather than a cream one.
; fog_sun_scatter 0.42 -> 0.10. This adds the sun's own colour to the fog along
; sightlines near it. It existed because looking down the gorge was looking within 30
; degrees of an 11.5-degree sun, which is the glare that sells a low sun over water.
; The sun is now 34 degrees up and 66 degrees east of +x — which is to say behind the
; shoulder of every vantage in tools/shots.json, all of which sit at +z looking toward
; -z. None of them looks anywhere near it, so at 0.42 this would only ever be a warm
; cast applied for no reason. It stays at 0.10 for the same reason it was cut.
; aerial_perspective 0.75 -> 0.90: the veil is 90% the actual sky behind the geometry,
; so distance takes on the sky's own blue. That is the whole mechanism of aerial
; perspective and it works far better with a blue sky than it did with an amber one.
; sky_affect stays 0: at anything above that the fog fogs the sky itself.
fog_enabled = true
fog_mode = 1
fog_light_color = Color(0.706, 0.769, 0.824, 1)
fog_sun_scatter = 0.1
fog_density = 1.0
fog_aerial_perspective = 0.9
fog_sky_affect = 0.0
fog_depth_curve = 0.62
fog_depth_begin = 18.0
fog_depth_end = 520.0

; --- Volumetric fog: the light shafts ---
; This existed for one shot: an 11.5 degree sun raking through the arch lattice. A
; 34-degree sun rakes it again, at a shallower angle and 66 degrees round toward +z, so
; the shafts run along the lattice rather than dropping through it — longer, shallower,
; and more of each one inside the frame. They are worth keeping (the RUBRIC wants
; motion and drifting dust in the light) but every unit of density is EXTINCTION, which
; is uniform in every direction and is exactly the milkiness to avoid.
;
; density 0.0011 -> 0.0008, with the sun's own light_volumetric_fog_energy
; (LightingRig.SUN_FOG_ENERGY) going 2.0 -> 2.6 to compensate. Shaft brightness goes as
; (fog energy * density) so the shafts land at 0.94 of what they were, while the veil,
; which goes as density alone, drops 27%. That trade is worth more this round than
; last: the depth fog's own ramp above was pulled in to 18 m, so the two passes now
; compete for the same near field and the near field is where the playable corridor is.
; albedo, warm cream -> cool white. Volumetric fog is airborne water and dust
; scattering *sky*, and under a blue dome that scatter is blue-white. Cream here was
; the sunset showing through the one channel that is pure additive light.
; anisotropy 0.75 -> 0.70. The Henyey-Greenstein phase function at g = 0.70 is ~3.5x
; isotropic at 30 degrees off the sun and ~0.16x at 120, still a 22:1 ratio, so the
; shafts stay where the shafts are. Slightly wider than before because a high sun's
; shafts are seen from the side rather than looked along.
; length 80 keeps the 64 depth slices landing finely over the 10-40 m where the lattice
; actually is; detail_spread 2.6 bunches froxels nearer the camera for the same reason.
; gi_inject 0.5 and ambient_inject 0.3 are both UNIFORM lifts inside the fog, i.e. milk
; with no directional payoff; they stay low. sky_affect stays 0 or it fogs the sky.
; RiverLife adds a FogVolume of low mist over the water on top of this.
volumetric_fog_enabled = true
volumetric_fog_density = 0.0008
volumetric_fog_albedo = Color(0.94, 0.96, 1, 1)
volumetric_fog_gi_inject = 0.5
volumetric_fog_anisotropy = 0.7
volumetric_fog_length = 80.0
volumetric_fog_detail_spread = 2.6
volumetric_fog_ambient_inject = 0.3
volumetric_fog_sky_affect = 0.0

; --- Grade ---
; saturation 1.05 -> 1.12. The RUBRIC asks for "saturated and confident": AgX restores
; a lot of chroma on its own but it restores it toward plausible, and Porto at noon —
; azulejo blue, terracotta, ochre plaster, a hard blue sky — is a genuinely more
; saturated subject than a sunset, where everything converges on one hue. Held back
; from the 1.20 this pass first tried because the LUT's S-curve is a PER-CHANNEL
; curve: steepening it around the pivot already pulls the channels apart on anything
; that is not neutral, so it adds apparent saturation for free. 1.20 on top of the new
; curve pushed the reds on the Ribeira terraces past clay and into neon.
; contrast 1.04 -> 1.00. The LUT above now owns the contrast, and it puts it where the
; shadows are rather than pivoting the whole image about mid-grey; two contrast
; operators stacked is how the toe gets crushed by accident.
adjustment_enabled = true
adjustment_contrast = 1.0
adjustment_saturation = 1.12
adjustment_color_correction = SubResource("Grade_lut")
