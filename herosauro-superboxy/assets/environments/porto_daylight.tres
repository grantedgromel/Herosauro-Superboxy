[gd_resource type="Environment" load_steps=6 format=3]

[ext_resource type="Shader" path="res://assets/environments/porto_sky.gdshader" id="1_porto_sky"]

; Was porto_golden_hour.tres. The golden hour is gone: SunLight in bridge_arena.tscn
; now stands 51 degrees up at 5400 K, which is Porto on a clear morning, and every
; number below has been re-derived against that rather than dimmed toward it. The
; reasoning that used to live here about low sun on stone, warm clipping and glare
; down the gorge described a picture this resource no longer makes.
;
; WARNING, unchanged and still the most important line in the file: the text resource
; format keeps `;` comments on load, but Godot's inspector does NOT round-trip them.
; Re-save this from the editor and every comment here is gone. Edit it as text.

[sub_resource type="ShaderMaterial" id="SkyMat_porto"]
shader = ExtResource("1_porto_sky")
shader_parameter/zenith_color = Color(0.125, 0.325, 0.69, 1)
shader_parameter/upper_color = Color(0.322, 0.541, 0.804, 1)
shader_parameter/horizon_color = Color(0.741, 0.831, 0.898, 1)
shader_parameter/horizon_band = 0.3
shader_parameter/horizon_shape = 0.7
shader_parameter/zenith_shape = 0.9
shader_parameter/haze_color = Color(0.827, 0.878, 0.925, 1)
shader_parameter/haze_tight_falloff = 18.0
shader_parameter/haze_tight_energy = 0.42
shader_parameter/haze_broad_falloff = 4.5
shader_parameter/haze_broad_energy = 0.26
shader_parameter/ground_color = Color(0.263, 0.275, 0.235, 1)
shader_parameter/ground_bounce = 0.55
shader_parameter/ground_band = 0.22
shader_parameter/ground_falloff = 1.1
shader_parameter/horizon_blend = 0.045
shader_parameter/halo_color = Color(1, 0.976, 0.925, 1)
shader_parameter/halo_tight_falloff = 220.0
shader_parameter/halo_tight_energy = 1.1
shader_parameter/halo_wide_falloff = 8.0
shader_parameter/halo_wide_energy = 0.16
shader_parameter/sun_radius = 0.014
shader_parameter/sun_energy = 22.0
shader_parameter/sun_limb = 0.18
shader_parameter/sun_ibl_scale = 0.15
shader_parameter/sky_energy = 1.15
shader_parameter/dither_strength = 0.013

[sub_resource type="Sky" id="Sky_porto"]
sky_material = SubResource("SkyMat_porto")
process_mode = 1
radiance_size = 3

; --- Grade_curve / Grade_lut ---
; The film grade, as a 1D LUT. adjustment_brightness/contrast/saturation are all
; achromatic, so a Texture2D correction is the only way to shape the three channels
; independently. Godot samples it PER CHANNEL (out.r = LUT(in.r).r, and so on), which
; makes a GradientTexture1D exactly a curves editor with independent R, G and B.
;
; The previous curve deliberately split-toned — warm highlights, cool shadows —
; because golden hour never clips neutral. Midday does. The job of this curve is now
; tonal SHAPE rather than colour separation. Saturation is left to
; adjustment_saturation, which does it without dragging hue.
;
; The shape is measured, not guessed. A first render of the daylight rig came back
; with this luminance distribution over shots 02, 03 and 07:
;
;     p1 0.12   p5 0.21   p50 0.61   p95 0.81   p99 0.87   fraction above 0.95: 0.000
;
; Nothing was clipping — but nothing reached white either, and the median sat two
; thirds of the way up. That is not a bright frame, it is a WASHED one, and it is the
; exact histogram the RUBRIC describes as "muddy" and "uniform flat illumination".
; The fix is not exposure (that only slides the whole thing) but RANGE: an S-curve
; with a real toe and a real shoulder, cutting the bottom fifth down and pulling the
; top fifth up to white.
;
; Read the stops as (input -> R, G, B), with slopes in the margin:
;   0.000  (0, 0.002, 0.008)  — a hair of lift, and the only stop with real channel
;          separation left in it. Shadows under a 51-degree sun are lit almost
;          entirely by a blue sky, so a faintly blue toe is the true colour of a
;          shadow rather than a look.
;   0.080  0.032.  slope 0.40 — the toe. This is where the frame gets its blacks.
;   0.220  0.150.  slope 0.84
;   0.450  0.450.  slope 1.30 — the pivot, dead on identity.
;   0.720  0.792.  slope 1.27 — the lift. The sunlit deck, the kerbs and the lit
;          facades land in this stretch and this is what makes them read as sunlit
;          rather than merely lit.
;   0.900  0.975.  slope 1.02 — the shoulder starts.
;   1.000  (1, 1, 1). slope 0.25. Clean neutral white. A midday sun clips white; the
;          warm clip the old curve carried was the single most golden-hour thing left
;          in the frame after the light itself.
;
; Against the measured distribution that maps p5 0.21 -> 0.14, p50 0.61 -> 0.65 and
; p99 0.87 -> 0.94, which combined with the exposure and white-point change below
; lands the median near 0.50 and puts the top percentile at white.
;
; Every channel is monotonic, so no tonal inversion is possible whatever the input
; encoding turns out to be.
[sub_resource type="Gradient" id="Grade_curve"]
offsets = PackedFloat32Array(0, 0.08, 0.22, 0.45, 0.72, 0.9, 1)
colors = PackedColorArray(0, 0.002, 0.008, 1, 0.032, 0.035, 0.042, 1, 0.15, 0.15, 0.152, 1, 0.45, 0.45, 0.45, 1, 0.792, 0.79, 0.788, 1, 0.975, 0.975, 0.975, 1, 1, 1, 1, 1)

[sub_resource type="GradientTexture1D" id="Grade_lut"]
gradient = SubResource("Grade_curve")

[resource]
background_mode = 2
sky = SubResource("Sky_porto")

; --- Ambient ---
; 0.55 -> 0.45 -> 0.32, and the frame STILL gets more ambient than it did at dusk,
; because the sky this reads is a great deal brighter: sky_energy went 1.0 -> 1.15 on
; top of a dome whose colours are a clear blue noon rather than a dark indigo dusk.
; Cutting the multiplier while the source brightens is the point — ambient is a
; constant term with no direction, so it is the one part of the fill that cannot shape
; anything, and every unit of it that SDFGI and SSIL carry instead is a unit that
; arrives occluded.
;
; The second cut, 0.45 -> 0.32, is measured: the first render of the daylight rig came
; back with a 5th percentile of 0.21, i.e. the darkest twentieth of the frame was still
; a light mid-grey. A floor that high is a second key light with no direction, and it
; is what makes shadows stop reading as shadows. LightingRig scales it back up by
; COMPAT_AMBIENT_SCALE on GL Compatibility, where neither SDFGI nor SSIL exists, and
; again if use_sdfgi is switched off.
;
; The colour is the 8% slice that is NOT sky (sky_contribution 0.92). Still blue, and a
; touch paler: at midday that slice stands in for light bouncing off pale stone under a
; blue dome, not for a dusk gradient.
ambient_light_source = 3
ambient_light_color = Color(0.647, 0.749, 0.925, 1)
ambient_light_sky_contribution = 0.92
ambient_light_energy = 0.32
reflected_light_source = 2

; --- Tonemap ---
; This is where the daylight is actually made, not in any albedo. A horizontal deck saw
; sin(11.5) = 0.20 of normal incidence under the old sun and sees sin(51) = 0.78 under
; this one, so even with the key cut 2.4 -> 2.0 the deck arrives 3.2x brighter — +1.7
; EV of real scene light that has to be spent deliberately rather than clawed back.
;
; exposure 1.05 -> 1.00 -> 0.72 and agx_white 10.5 -> 7.5 -> 4.0. These two moved
; together and the pairing is the whole trick, so they have to be read together.
;
; AgX log-encodes the scene between a fixed floor of -12.47 EV and log2(white), so the
; white point is a RANGE control, not a brightness control: at white 7.5 the encoder is
; spreading 15.4 stops across the output, and a scene that only occupies four of them
; comes out compressed into the middle. That is exactly what the first render measured
; — median 0.61, 99th percentile 0.87, nothing within 0.13 of white anywhere in three
; shots. Dropping white to 4.0 narrows the encoded range to 14.5 stops, which lifts
; everything; dropping exposure to 0.72 (-0.47 EV) puts the median back where it
; belongs. The net is the same mid-tone with more range above and below it, which is
; the definition of contrast and the thing the frame was missing.
;
; What that leaves: sunlit deck granite at 0.32 scene-referred, sunlit plaster near
; 0.9, the sun disk at 44 and the water's glint above it. The last two clip, which is
; correct — they are the two things in a midday frame that are allowed to.
; agx_contrast 1.42 -> 1.62 buys further punch inside the tonemapper's own S-curve,
; which is better behaved than doing it afterwards with adjustment_contrast because it
; happens before the display transform rather than on top of it.
tonemap_mode = 4
tonemap_exposure = 0.72
tonemap_agx_white = 4.0
tonemap_agx_contrast = 1.62

; --- Screen-space reflections ---
; The Douro reflecting the arch and the lit city is THE Porto image, so this is tuned
; for one specific case: a near-mirror plane (the water shader runs ROUGHNESS 0.07)
; seen at a grazing angle from 17 m up, with rays that have to travel most of the
; screen. max_steps 112 for that reach; depth_tolerance 0.22 because 0.3 is wider than
; the lattice members are thick and smears them into a smudge; fade_in 0.05 so the
; reflection starts at the waterline instead of leaving a gap under the piers; fade_out
; 6.0 so the far half of the reflection survives instead of dissolving mid-river.
; Untouched by the daylight pass: none of it is about the time of day, and the
; reflection matters MORE now that what it reflects is a blue sky with an iron arch
; across it rather than an amber wash.
ssr_enabled = true
ssr_max_steps = 112
ssr_fade_in = 0.05
ssr_fade_out = 6.0
ssr_depth_tolerance = 0.22

; --- SSAO / SSIL ---
; radius 0.9 is tuned to the ~2-unit characters, not the 100-unit deck.
; power stays 1.2: every window reveal and lattice node has a real crease, and a
; sharper exponent turns each of them into a hard dark ring.
; light_affect 0.15 -> 0.22. AO acting on direct light is not physical, and under a
; raking sun it was not needed — the sun itself drew the creases. A 51-degree sun
; reaches into most of them, and "contact is mandatory" in the RUBRIC is a statement
; about direct light: this is what keeps a barrel from floating when the sun is hitting
; both the barrel and the deck under it.
; intensity 1.5 -> 1.85 and ssil_intensity 0.55 -> 0.60: a brighter sky means more
; indirect to occlude and more indirect to gather, and both scale with it. The extra
; on SSAO past that is paying for the ambient cut — with the constant term down to
; 0.32 the creases are darker to begin with, and AO is the term that makes that read
; as contact rather than as a dark object.
ssao_enabled = true
ssao_radius = 0.9
ssao_intensity = 1.85
ssao_power = 1.2
ssao_detail = 0.4
ssao_light_affect = 0.22
ssil_enabled = true
ssil_radius = 4.0
ssil_intensity = 0.6

; --- SDFGI ---
; 5 cascades off the default 0.2 min cell = a 12.8-unit cascade 0 and ~205 units total,
; enough for the bridge and the far bank. read_sky_light stays true (this is an
; exterior) and is stated explicitly because it is exactly why ambient_light_energy
; could come down so far. energy 0.85 -> 0.95: SDFGI is the only thing in the frame
; that carries bounce with the colour of what it bounced off *and* with occlusion, and
; the RUBRIC asks for exactly that — green off the banks, terracotta off the roofs.
; bounce_feedback stays 0.3: feedback is light amplification, and amplification is what
; turns indirect into wash.
sdfgi_enabled = true
sdfgi_use_occlusion = true
sdfgi_read_sky_light = true
sdfgi_bounce_feedback = 0.3
sdfgi_cascades = 5
sdfgi_y_scale = 1
sdfgi_energy = 0.95
sdfgi_normal_bias = 1.4
sdfgi_probe_bias = 1.4

; --- Glow ---
; threshold 1.15 -> 1.25. Everything got brighter, so a threshold that used to pick out
; only the sun and the lamps now picks out ordinary sunlit plaster as well, and
; screen-blending that is a mid-tone lift across the whole frame — the fastest way to
; turn a bright day into a hazy one. Raised until it again selects only what should
; bloom: the sun disk, the water's glint path, the glazed azulejo highlights.
; intensity 0.38 -> 0.34 for the same reason.
; luminance_cap 8 stops the sun disk (44 scene-referred) from smearing the upper frame
; through the widest blur levels.
glow_enabled = true
glow_levels/1 = 0.0
glow_levels/2 = 0.3
glow_levels/3 = 0.7
glow_levels/4 = 1.0
glow_levels/5 = 0.8
glow_levels/6 = 0.4
glow_levels/7 = 0.0
glow_normalized = true
glow_intensity = 0.34
glow_bloom = 0.02
glow_blend_mode = 1
glow_hdr_threshold = 1.25
glow_hdr_luminance_cap = 8.0

; --- Depth fog: the aerial perspective ---
; Depth mode is amount = pow(smoothstep(begin, end, dist), curve) * density, so
; `density` is literally the blend at and beyond `end`. Density is not the milkiness
; dial — RANGE is. Full density over a 640 m range with a 0.9 curve gives a gradient
; rather than a veil, and a gradient is what reads as depth. Composited with the
; volumetric pass below, at the distances this scene actually has geometry:
;
;     deck / hero      0-40 m    <4%    nothing playable is veiled
;     bridge ends      50 m       6%
;     arch, abutments  70 m       9%
;     Ribeira terraces 100 m     12%
;     Clerigos, Serra  130 m     16%
;     scan, near edge  168 m     22%
;     scan, far edge   340 m     57%
;     horizon          640 m+   100%    the water reaches sky colour before its
;                                       geometry runs out, so the river plane's far
;                                       edge stops being visible at all
;
; The two numbers that changed are the two that were about the sunset:
;
; fog_light_color, warm haze amber -> pale sky blue. This is the 10% of the veil that
; is NOT the sky behind the geometry, and an amber tint in it was putting a gold cast
; on every distant surface in a frame lit at 5400 K.
; fog_sun_scatter 0.42 -> 0.10. This adds the sun's own colour to the fog along
; sightlines near it. It existed because looking down the gorge was looking within 30
; degrees of an 11.5-degree sun, which is the glare that sells a low sun over water.
; The sun is now 51 degrees up and no vantage in tools/shots.json looks anywhere near
; it, so at 0.42 this would only ever be a warm cast applied for no reason.
; aerial_perspective 0.75 -> 0.90: the veil is 90% the actual sky behind the geometry,
; so distance takes on the sky's own blue. That is the whole mechanism of aerial
; perspective and it works far better with a blue sky than it did with an amber one.
; sky_affect stays 0: at anything above that the fog fogs the sky itself.
fog_enabled = true
fog_mode = 1
fog_light_color = Color(0.741, 0.827, 0.902, 1)
fog_sun_scatter = 0.1
fog_density = 1.0
fog_aerial_perspective = 0.9
fog_sky_affect = 0.0
fog_depth_curve = 0.9
fog_depth_begin = 40.0
fog_depth_end = 640.0

; --- Volumetric fog: the light shafts ---
; This existed for one shot: an 11.5 degree sun raking through the arch lattice. That
; shot is gone, and a 51-degree sun through the same lattice makes short steep shafts
; onto the deck instead of long horizontal ones down the gorge. They are worth keeping
; — the RUBRIC wants motion and drifting dust in the light — but they are worth much
; less than they were, and every unit of density is extinction, which is uniform in
; every direction and is exactly the milkiness to avoid.
;
; So density comes down again, 0.0016 -> 0.0011, and the sun's own
; light_volumetric_fog_energy (LightingRig.SUN_FOG_ENERGY) comes down 2.4 -> 2.0 with
; it. Shaft brightness goes as (fog energy * density) while the veil on the playable
; deck goes as density alone, so the composite haze at 50 m — the far parapet from
; mid-deck — drops from 7.8% to 5.5% for a shaft only a third dimmer.
; albedo, warm cream -> cool white. Volumetric fog is airborne water and dust
; scattering *sky*, and under a blue dome that scatter is blue-white. Cream here was
; the sunset showing through the one channel that is pure additive light.
; anisotropy 0.75 -> 0.70. The Henyey-Greenstein phase function at g = 0.70 is ~2.9x
; isotropic at 30 degrees off the sun and ~0.17x at 120, still a 17:1 ratio, so the
; shafts stay where the shafts are. Slightly wider than before because a high sun's
; shafts are seen from the side rather than looked along.
; length 80 keeps the 64 depth slices landing finely over the 10-40 m where the lattice
; actually is; detail_spread 2.6 bunches froxels nearer the camera for the same reason.
; gi_inject 0.5 and ambient_inject 0.3 are both UNIFORM lifts inside the fog, i.e. milk
; with no directional payoff; they stay low. sky_affect stays 0 or it fogs the sky.
; RiverLife adds a FogVolume of low mist over the water on top of this.
volumetric_fog_enabled = true
volumetric_fog_density = 0.0011
volumetric_fog_albedo = Color(0.94, 0.96, 1, 1)
volumetric_fog_gi_inject = 0.5
volumetric_fog_anisotropy = 0.7
volumetric_fog_length = 80.0
volumetric_fog_detail_spread = 2.6
volumetric_fog_ambient_inject = 0.3
volumetric_fog_sky_affect = 0.0

; --- Grade ---
; saturation 1.05 -> 1.12. The RUBRIC asks for "saturated and confident": AgX restores
; a lot of chroma on its own but it restores it toward plausible, and Porto at noon —
; azulejo blue, terracotta, ochre plaster, a hard blue sky — is a genuinely more
; saturated subject than a sunset, where everything converges on one hue. Held back
; from the 1.20 this pass first tried because the LUT's S-curve is a PER-CHANNEL
; curve: steepening it around the pivot already pulls the channels apart on anything
; that is not neutral, so it adds apparent saturation for free. 1.20 on top of the new
; curve pushed the reds on the Ribeira terraces past clay and into neon.
; contrast 1.04 -> 1.00. The LUT above now owns the contrast, and it puts it where the
; shadows are rather than pivoting the whole image about mid-grey; two contrast
; operators stacked is how the toe gets crushed by accident.
adjustment_enabled = true
adjustment_contrast = 1.0
adjustment_saturation = 1.12
adjustment_color_correction = SubResource("Grade_lut")
