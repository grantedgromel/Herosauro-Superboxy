[ext_resource type="Material" path="res://assets/materials/toon_bridge.tres" id="2_deck"]
[ext_resource type="Shader" path="res://assets/shaders/water_wave.gdshader" id="3_water"]
[ext_resource type="PackedScene" path="res://scenes/world/sky_background.tscn" id="4_sky"]

; The deck. Collider and mesh are deliberately NOT the same box:
;   - the collider's top is the walkable surface at y = 2, flat from parapet to
;     parapet, so nothing bridge_arena.gd lays on top can ever be a trip hazard;
;   - the mesh stops 4 cm lower, at BridgeArena.STRUCTURE_TOP, and that 4 cm is
;     the depth every paving seam, kerb joint and flagstone groove reveals.
; Both keep the underside at y = 0 (BridgeArena.DECK_BOTTOM), which is what the
; arch hangs from. Width is 14: a 10 m carriageway between the kerbs (the boss
; arena is z in [-5, 5]) plus a 2 m footway and parapet on each side.
[sub_resource type="BoxShape3D" id="Box_deck"]
size = Vector3(100, 2, 14)

[sub_resource type="BoxMesh" id="Mesh_deck"]
size = Vector3(100, 1.96, 14)

; --- River ---
; 240x240 stopped 120 units out, which was already short of the far bank; with the
; photogrammetry backdrop standing between z = -131 and z = -390 and reaching
; x = +-154, a plane that size would end in a hard edge right in front of it, and the
; scan's own untextured river plane and its hanging capture skirt would be on show
; below the cut. 900x900 recentred on z = -140 covers x,z in [-450, 450] x [-590, 310]
; — 296 units of margin past the scan in every direction, and 310 units of water on
; the +z side where nothing else is modelled at all.
;
; Subdivision scales with it rather than staying put: 900/179 = 5.03-unit quads
; against the old 240/49 = 4.90, so the swell is sampled exactly as densely as Wave 1
; tuned it for. That is the whole reason the wave uniforms below are left alone. The
; cost is 32,400 vertices doing six trig ops each, in one draw call.
[sub_resource type="PlaneMesh" id="Mesh_river"]
size = Vector2(900, 900)
subdivide_width = 178
subdivide_depth = 178

; --- Mat_river ---
; Uniform-by-uniform against assets/shaders/water_wave.gdshader.
;
; ROUND 3. This block was three rounds stale, and the whole of it described a sunset
; that the scene stopped having when SunLight was re-keyed. The shader's own header
; has been saying so for two rounds — "STILL BROKEN AND STILL NOT MINE TO FIX", with
; the correct numbers listed — because these sub-resources belong to the world stream
; and the shader belongs to atmosphere. Acted on now.
;
; A critic scored the region x 520-780, y 540-640 of 06_river_wide as "a hard-edged
; dark brown/blue mottled decal floating on the water surface... crisp polygonal
; edges", and called it a geometry bug. It is not geometry: a ray cast from that
; vantage through 24 pixels of that region hits NOTHING in the scene but this plane.
; It is this material. The fragment stage does
;
;     mirror = clamp(pow(1 - dot(N, V), horizon_falloff) + h * 0.18, 0, 1) * 0.30
;     ALBEDO = mix(deep_color, shallow_color, mirror)
;
; so with shallow_color at the old sunset amber (0.86, 0.685, 0.47) the river's own
; grazing term mixes BROWN into BLUE, and pow(., 5.2) makes that mix swing hard over
; the small changes in N that the 5.03-unit wave quads produce. Brown/blue mottling
; with polygonal edges is the literal output of those two lines. Give the mirror term
; the pale estuary sky it is actually reflecting and the same maths produces a value
; step in one hue instead of a two-hue stain.
;
; shallow_color (0.86, 0.685, 0.47) -> (0.72, 0.80, 0.87). This is what a grazing
; sightline returns, i.e. what the river is mirroring, and the sky shader's
; horizon_color is now (0.66, 0.76, 0.85). A mirror cannot out-hue what it reflects.
; Kept a shade above horizon_color so the far water still reads as water.
;
; glint_color (1, 0.8, 0.55) -> (1, 0.97, 0.9). The glitter path is specular
; sunlight, so it is the sun's colour: SunLight is 5100 K warm white (1, 0.935,
; 0.855), not 3200 K amber.
;
; sun_direction (-0.859785, 0.19995, -0.469882) -> (0.337181, 0.559193, 0.757364).
; The old value is the ORIGINAL sunset sun: 11.5 degrees up over the -x/-z quadrant.
; SunLight now stands at 34 degrees over +x/+z, and a DirectionalLight3D shines down
; its own -Z, so the direction *towards* the sun is its +Z basis column — read as the
; third element of each Transform3D ROW, because the twelve floats in that literal are
; rows and not axes. The glitter path was consequently ~121 degrees of azimuth away
; from every other highlight in the frame.
;
; glint_sharpness 165 -> 200. 165 was chosen for an 11.5-degree sun, which lays a very
; long soft glitter path because the reflected angle sweeps slowly near the horizon. At
; 34 degrees the lobe tightens, though not back to the 240 a high sun would want.
;
; glint_strength 1.2, kept. The shader writes the glitter as EMISSION specifically so it
; blooms in the HDR buffer, and the environment's glow_hdr_threshold is 1.05 — under
; about 1.1 it could never reach the glow pass at all.
;
; water_roughness 0.07, kept: the plane is 14x its original area, most of it grazing,
; and this project has MSAA + FXAA but no TAA, neither of which touches shading
; aliasing. A slightly wide lobe is cheap insurance against sub-pixel chop sparkling.
;
; horizon_falloff 5.2, kept. fresnel = pow(1 - facing, horizon_falloff) and a HIGH
; fresnel selects shallow_color, so the authored 3.0 counted almost the whole surface
; as grazing and rendered the Douro as a flat pale sheet — a sandbank, not a river.
; 5.2 keeps the mirror term on the far water and lets deep_color own the near field.
;
; deep_color (0.115, 0.205, 0.245), kept: Douro silt-green, an estuary channel with
; depth rather than open-ocean blue.
;
; foam_strength 0.18, kept: whitecaps key off smoothstep(0.45, 0.95, h) on the
; unit-amplitude swell, so they fire on every crest however calm the water is set to
; be. The Douro at Porto is a tidal pool between two banks; foam belongs on the near
; water as a hint.
;
; wave_speed/height/scale/chop_strength/flow are Wave 1's, deliberately untouched —
; they were tuned against a render and the resubdivision above means the bigger plane
; samples them just as well. One caveat for whoever owns the shader: field_pos() drifts
; the wave field along (12, 4) in xz, i.e. mostly +x, but this arena's banks are the
; masses at |x| >= 50, so the Douro here runs along Z. The downstream drift is 90
; degrees out. At flow = 0.02 it is 0.24 units/s and reads as general movement rather
; than a sideways river, so it is left alone here.
[sub_resource type="ShaderMaterial" id="Mat_river"]
shader = ExtResource("3_water")
shader_parameter/shallow_color = Color(0.72, 0.8, 0.87, 1)
shader_parameter/deep_color = Color(0.115, 0.205, 0.245, 1)
shader_parameter/wave_speed = 0.5
shader_parameter/wave_height = 0.35
shader_parameter/wave_scale = 0.18
shader_parameter/flow = 0.02
shader_parameter/glint_color = Color(1, 0.97, 0.9, 1)
shader_parameter/glint_strength = 1.2
shader_parameter/sun_direction = Vector3(0.337181, 0.559193, 0.757364)
shader_parameter/glint_sharpness = 200.0
shader_parameter/chop_strength = 1.0
shader_parameter/water_roughness = 0.07
shader_parameter/horizon_falloff = 5.2
shader_parameter/foam_color = Color(0.93, 0.95, 0.96, 1)
shader_parameter/foam_strength = 0.18

[node name="BridgeArena" type="Node3D"]
script = ExtResource("1_arena")

[node name="Bridge" type="StaticBody3D" parent="."]
collision_layer = 1
collision_mask = 1

[node name="CollisionShape3D" type="CollisionShape3D" parent="Bridge"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1, 0)
shape = SubResource("Box_deck")

[node name="Mesh" type="MeshInstance3D" parent="Bridge"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.98, 0)
mesh = SubResource("Mesh_deck")
surface_material_override/0 = ExtResource("2_deck")

; The two 100x2x0.4 rail walls that used to fence the deck are gone.
; bridge_arena.gd builds a proper parapet in their place — granite plinth, iron
; balusters, handrail — with one collider box per side standing in for the lot.

; Recentred from z = 0 to z = -140 so the extra water goes where the view goes: down
; the gorge, past the procedural banks and under the photogrammetry backdrop. Still at
; y = -15 — bridge_arena.gd buries the abutments to -16.4 against that number, and
; sky_background.gd bobs its rabelos on it at -14.75.
;
; Shadows off. There is no riverbed for it to shadow, and 64k triangles of water in
; every directional shadow split is pure cost. Left on the default GI mode: it is
; static, it is below everything, and its warm bounce off the sunset is worth having.
[node name="River" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -15, -140)
cast_shadow = 0
mesh = SubResource("Mesh_river")
surface_material_override/0 = SubResource("Mat_river")

; --- SunLight: Porto at 08:40, not at 10:50 ---
; The twelve floats in a Transform3D literal are the basis ROWS, so the +Z axis --
; the direction light comes FROM, because a DirectionalLight3D shines down its own
; -Z -- is the third element of each row: (0.337181, 0.559193, 0.757364).
;
; 51 degrees -> 34.0 degrees of elevation, and the horizontal part swings from 30 to
; 66 degrees east of +x. Both numbers moved, and both had to.
;
; WHY IT CAME DOWN. Round 1's most expensive finding was that nothing in frame is
; planted by a shadow the player can see, and the reason was arithmetic, not a
; toggle: shadows were on and rendering, but at 51 degrees a 1.2 m parapet throws
; 1.2/tan(51) = 0.97 m of shadow, straight down at its own feet, where a deck-level
; camera cannot see it. Technically correct midday light is the flattest light there
; is. At 34 degrees the same parapet throws 1.78 m, and a lamppost globe 4.33 m over
; the footway throws 6.4 m -- right across the ten-metre corridor. Shape comes from
; shadow; this is where the shape comes from.
;
; WHY IT SWUNG EAST. The throw only helps if it crosses the deck, and the deck runs
; along X. At the old azimuth only half the throw was in Z, so 1.78 m of shadow would
; still have died on the footway. sin(66) = 0.91 puts 1.63 m of the parapet's shadow
; and 5.9 m of the lamppost's straight across the carriageway.
;
; The swing pays for itself twice more. The parapet lattice, the arch and every
; baluster present their broad faces to +-Z, and those faces went from
; N.L = 0.315 to 0.757 -- 2.4x the key on the hero material of the location, which
; Round 1 measured as a black cutout at mean RGB (11, 16, 27). And the Ribeira
; facades, which face +x, drop from 0.545 to 0.337: they are still clearly lit, their
; window reveals and cornices finally throw shadows across them instead of being
; flat-lit, and the background stops out-shouting the playable deck by as much.
;
; NEITHER OF THOSE TWO HAS LANDED YET, and the reason is not this vector. Everything
; MeshBaker bakes -- all the ironwork, all the abutment masonry, every Ribeira facade
; -- currently stores vertex normals that are the NEGATIVE of the engine's convention
; (mesh_baker.gd's _tri_uv takes +RH(a, b, c); Godot's own primitives store -RH for
; the identical winding). Ray-probing the parapet from three of the shot vantages
; returns N = (0, 0, -1) on surfaces facing a +z camera, i.e. N.L = -0.757 against
; this sun, so those surfaces receive NO key at all and are lit by the blue sky fill
; alone -- which is exactly why they measure blue-black at (11, 18, 33). The world
; stream has the same finding written up independently in
; scripts/world/landmarks/_winding_probe.gd. Until mesh_baker.gd is fixed, the two
; gains above are arithmetic rather than pixels, and the first thing to re-measure
; afterwards is the focal hierarchy: the background is currently darker than the
; design intends, not brighter.
;
; It is still a real Porto sun, just earlier in the same morning. Latitude 41.15 N,
; declination +6.5 degrees (about 3 April, or 9 September), hour angle 49.7 degrees:
; altitude 34.0, azimuth 114 from north = 66 east of south. In this arena's compass
; +x is south and -z is downstream toward the Atlantic, so that is where it belongs.
; Every vantage in tools/shots.json sits at +z looking toward -z, and the +z component
; is now 0.76, i.e. the key is firmly over the camera's shoulder rather than in its
; face -- no vantage looks anywhere near the disk.
;
; energy 2.0 -> 2.8. This is bookkeeping, not a brightening: a horizontal deck sees
; sin(34) = 0.559 of normal incidence against sin(51) = 0.777, so 2.8 x 0.559 = 1.57
; against the old 2.0 x 0.777 = 1.55. The most-looked-at surface in the game lands
; within 1% of where the tonemap was already graded for it, and the entire change buys
; direction rather than exposure -- the RUBRIC's "exposure-driven, not
; multiplier-driven" read the way it is meant to be.
;
; colour: 5100 K, a clear-day sun at 34 degrees through ~1.79 air masses. Very
; slightly warmer than the 5400 K it was at 51, because that is what an extra half an
; air mass does. R-B = 0.145; a 3200 K sunset is 0.46, and _atmosphere_probe.gd fails
; anything at or above 0.2.
;
; angular_distance stays 0.53, the sun's true angular diameter. It sets the penumbra
; through project.godot's soft_shadow_filter_quality, and 0.53 degrees means a
; contact shadow is still hard at its own feet and softens over metres, which is what
; plants an object rather than stickering it.
[node name="SunLight" type="DirectionalLight3D" parent="."]
transform = Transform3D(0.913546, -0.227445, 0.337181, 0, 0.829038, 0.559193, -0.406737, -0.510845, 0.757364, 0, 30, 0)
light_color = Color(1, 0.935, 0.855, 1)
light_energy = 2.8
light_angular_distance = 0.53
shadow_enabled = true
; directional_shadow_max_distance was never set, so it sat on Godot's default of
; 100 m — in a world that spans about 900 units of river with the Ribeira
; terraces at 60-150 m and the photogrammetry backdrop out past 130. Everything
; beyond 100 m therefore received NO shadow at all, which is why an adversarial
; critic measured "no inter-building shading anywhere on a hillside of stacked
; terraces" and "every mid-ground and background object is floating on ambient"
; while simultaneously measuring correct, sky-filled, correctly-perspectived
; shadows in the near field. Both readings were right; the cascades simply
; stopped.
;
; 260 m reaches the far Gaia bank and the whole Ribeira stack while stopping
; short of the backdrop scan, which is a photogrammetric surface with its own
; baked lighting and gains nothing from a cascade.
;
; The cost is texel density: four cascades over 260 m instead of 100 spreads the
; same 4096 map 2.6x thinner. Paid back two ways — pancake_size 0 removes the
; depth-range compression that trades near precision for far, and the split
; ratios below are pushed well under Godot's defaults (0.1/0.2/0.5) so cascade 0
; still covers roughly the first 26 m, which is the whole playable corridor, at
; better than the old density.
directional_shadow_max_distance = 260.0
directional_shadow_split_1 = 0.06
directional_shadow_split_2 = 0.16
directional_shadow_split_3 = 0.42
directional_shadow_blend_splits = true
directional_shadow_pancake_size = 0.0

[node name="SkyBackground" parent="." instance=ExtResource("4_sky")]
