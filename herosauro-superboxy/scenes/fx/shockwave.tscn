[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/fx/shockwave.gd" id="1_wave"]

[sub_resource type="SphereShape3D" id="Sphere_wave"]
radius = 0.5

; The wave's visual is built in code: the baked annulus every impact in the game
; shares (ImpactFX.ring_mesh) plus a MultiMesh dust wall on the rim. The TorusMesh
; that used to live here was a flat translucent hoop being resized by a tween — one
; unshaded colour, no dust, no interaction with the deck. See shockwave.gd.
[node name="Shockwave" type="Area3D"]
script = ExtResource("1_wave")

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
shape = SubResource("Sphere_wave")
