# Godot 4 editor data / import cache (regenerated on open)
.godot/

# Exported builds
/build/
/export/
*.tmp

# Generated HTML5 export. CI rebuilds this from source on every push and
# publishes it to the gh-pages branch; it is deliberately NOT committed back
# here. A 16 MB index.pck regenerated on two branches is an unmergeable binary
# conflict on every pull request, and the artifact carries no information the
# source doesn't already have.
#
# The two marker files ARE tracked: .gdignore keeps Godot from re-importing a
# local export as project resources, and .nojekyll keeps Pages serving the
# directory verbatim.
/web/*
!/web/.gdignore
!/web/.nojekyll

# Harness scratch: captures, contact sheets and diff heatmaps are outputs of a
# review round, not sources. They are large, they change on every run, and the
# thing worth keeping from a round is the findings, not the pixels.
/shots/
tools/__pycache__/

# Throwaway investigation probes. CI runs EVERY scripts/**/_*probe.gd as a gate,
# so a one-off scratch probe left in the tree becomes a permanent CI job that
# nobody owns — and the lead's checkpoint commits use `git add -A`, which will
# happily sweep one in. Name a temporary probe `_scratch_*.gd` and it stays local.
# A probe worth keeping earns a real name and a real verdict.
scripts/**/_scratch_*.gd
scripts/**/_scratch_*.gd.uid
scripts/**/_render_tmp.gd
scripts/**/_render_tmp.gd.uid
# Throwaway measurement scripts land at the project root rather than under
# scripts/, because they are not part of any stream. Same rule: local only.
/_*_probe.gd
/_*_probe.gd.uid
/_tmp_*.gd
/_tmp_*.gd.uid

# OS cruft
.DS_Store
Thumbs.db
